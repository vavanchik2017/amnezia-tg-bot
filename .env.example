# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated Telegram User IDs of administrators allowed to use the bot
ADMIN_IDS=123456789

# Name of your AmneziaWG container (as shown in docker ps)
VPN_CONTAINER_NAME=amnezia-awg2

# Public IP or domain of your VPS (used as Endpoint in client configs)
# If empty, the bot will try to detect it automatically via public IP service
SERVER_HOST=

# Port of AmneziaWG (leave empty to auto-detect from container)
SERVER_PORT=

# Interface name in container (leave empty to auto-detect, e.g. awg0 or wg0)
WG_INTERFACE=

# Client subnet for IP pool allocation (CIDR)
CLIENT_IP_SUBNET=10.8.0.0/24

# DNS for clients
CLIENT_DNS=1.1.1.1, 1.0.0.1

# Statistics polling interval in seconds (300 = 5 minutes)
STATS_POLL_INTERVAL=300

# SQLite Database location inside container
DB_PATH=/app/data/bot.db
